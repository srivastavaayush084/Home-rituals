# Server configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=supersecretjwtsecretkeyshouldbechangedinproduction

CLIENT_URL=http://localhost:5173

# Database configuration (MongoDB)
DATABASE_URL="mongodb://localhost:27017/homerituals"

# Initial Admin details for database seeding
ADMIN_EMAIL=admin@homerituals.com
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME="Home Rituals Admin"

# Cloudinary configuration (Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway & Refund Configuration (Test/Sandbox & Live/Production)
# Environment: test or production
RAZORPAY_ENV=test
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Webhook Secret for signature validation (used for payments & refunds: refund.processed, refund.failed)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# SMTP Email configuration (Transactional notifications)
# If left commented or blank, emails will print to the console instead
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_email_app_password
# EMAIL_FROM="Home Rituals <no-reply@homerituals.com>"

# Meta WhatsApp Cloud API & Webhook Configuration
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_random_webhook_verify_token_32_chars
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_API_VERSION=v21.0

