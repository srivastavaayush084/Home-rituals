# Home Rituals Client Environment Variables
# API Server base URL (leave empty when using Vite proxy in local development)
VITE_API_URL=http://localhost:5000

# Optional: Public Razorpay Key ID (the key is dynamically provided by backend /api/payments/razorpay/create-order)
# VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
